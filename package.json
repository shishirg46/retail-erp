    "test:http:pagination": "vitest run tests/http/pagination.test.ts",
    "test:http:voids": "vitest run tests/http/voids-http.test.ts",
    "test:http:exports": "vitest run tests/http/exports-http.test.ts",
    "test:frontend": "vitest run --config vitest.frontend.config.ts",

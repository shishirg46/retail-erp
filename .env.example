# Required — PostgreSQL connection string for the application
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/erp_retail"

# Required — Better Auth secret for session signing (generate a long random string)
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Optional — Better Auth base URL (defaults to http://localhost:3000)
# BETTER_AUTH_URL="http://localhost:3000"

# Optional — IANA timezone for shop-local report date handling (defaults to Asia/Kathmandu)
# ERP_TIMEZONE="Asia/Kathmandu"

# Required for tests only — separate test database (never the development DB)
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/erp_retail_test"

# Optional — seed script overrides (defaults: owner / ownerpass123)
# OWNER_USERNAME="owner"
# OWNER_PASSWORD="ownerpass123"

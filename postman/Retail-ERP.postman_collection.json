    {
      "name": "Stock Adjustments",
      "description": "D6 semantics: DAMAGE quantity = amount ruined (-delta); CORRECTION quantity = desired final level (change = target - current). Negative results are rejected.",
      "item": [
        {
          "name": "DAMAGE 2 (Biscuits)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.test('movement -2', () => pm.expect(pm.response.json().movement.qtyChange).to.eql(-2));",
                  "pm.test('reason DAMAGE', () => pm.expect(pm.response.json().movement.reason).to.eql('DAMAGE'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/stock/adjustments",

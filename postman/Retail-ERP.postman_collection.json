{
  "info": {
    "name": "Retail ERP — Full Coverage",
    "description": "Products, Suppliers, Purchases, Supplier Payments, Customers, Customer Payments, Sales. Run folders in order; ids chain via environment variables. Products/Sales pricing run off the min-cost DP; customer credit lifecycle plus D4/D5 semantics are covered in the Customer Payments folder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    }
  ],
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "Create Regular Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.test('stock 0', () => pm.expect(pm.response.json().stockQty).to.eql(0));",
                  "pm.test('chain regularId', () => pm.environment.set('regularId', pm.response.json().id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/products",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Regular Item\",\"category\":\"Grocery\",\"unit\":\"pcs\",\"costPrice\":10,\"currentPrice\":20}"
            }
          }
        },
        {
          "name": "Create Tiered Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.test('2 tiers', () => pm.expect(pm.response.json().priceTiers).to.have.lengthOf(2));",
                  "pm.test('chain tieredId', () => pm.environment.set('tieredId', pm.response.json().id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/products",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Tiered Item\",\"category\":\"Grocery\",\"unit\":\"pcs\",\"costPrice\":30,\"currentPrice\":20,\"priceTiers\":[{\"minQty\":3,\"price\":50},{\"minQty\":5,\"price\":90}]}"
            }
          }
        },
        {
          "name": "List Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('list', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products",
            "header": []
          }
        },
        {
          "name": "Get Product by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products/{{regularId}}",
            "header": []
          }
        }
      ]
    },

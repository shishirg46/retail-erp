    {
      "name": "Customer Payments & Credit Lifecycle",
      "description": "CREDIT sales create no wallet entry; payments deposit into the wallet and may overpay (D4). saleId is traceability only (D5): must match owner and be a CREDIT sale.",
      "item": [
        {
          "name": "CREDIT sale (customer, tiered qty6 = 100)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.test('total 100', () => pm.expect(pm.response.json().total).to.eql(100));",
                  "pm.test('CREDIT', () => pm.expect(pm.response.json().paymentType).to.eql('CREDIT'));",
                  "pm.test('chain creditSaleId', () => pm.environment.set('creditSaleId', pm.response.json().id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/sales",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"paymentType\":\"CREDIT\",\"customerId\":\"{{creditCustomerId}}\",\"items\":[{\"productId\":\"{{tieredId}}\",\"quantity\":6}]}"
            }
          }
        },
        {
          "name": "Payment 40 → balance 60",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/customer-payments",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"customerId\":\"{{creditCustomerId}}\",\"amount\":40}"
            }
          }
        },
        {
          "name": "Payment 60 → balance 0",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/customer-payments",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"customerId\":\"{{creditCustomerId}}\",\"amount\":60}"
            }
          }
        },
        {
          "name": "Overpayment 700 → prepaid -660 (D4)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/customer-payments",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"customerId\":\"{{creditCustomerId}}\",\"amount\":700}"
            }
          }
        },
        {
          "name": "Sale-linked payment (valid, D5)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.test('echoes saleId', () => pm.expect(pm.response.json().saleId).to.eql(pm.environment.get('creditSaleId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/customer-payments",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
